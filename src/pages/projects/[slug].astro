---
import { getCollection, render } from 'astro:content';
import type { InferGetStaticPropsType } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkflowDemo from '../../components/WorkflowDemo.astro';
import { assetUrl, sectionUrl, site } from '../../data/site';
import snapshot from '../../data/github.json';
export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort(
    (a, b) => a.data.order - b.data.order,
  );
  if (!projects.length) throw new Error('No project pages would be generated.');
  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: {
      project,
      previous: projects[index - 1],
      next: projects[index + 1],
    },
  }));
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { project, previous, next } = Astro.props;
const { Content, headings } = await render(project);
const entries = snapshot.repositories as Record<
  string,
  { language: string | null; pushedAt: string; url: string }
>;
const repository = entries[project.data.repository];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.data.title,
  description: project.data.description,
  url: new URL(assetUrl(`projects/${project.id}/`), Astro.site).href,
  creator: { '@type': 'Person', name: site.name, url: site.portfolio },
  keywords: project.data.techStack,
};
---

<BaseLayout
  schema={schema}
  title={`${project.data.title} — ${site.name}`}
  description={project.data.description}
  image={assetUrl(`previews/${project.id}.png`)}
  imageAlt={`${project.data.title} — project case study by ${site.name}`}
>
  <article class="container case-study">
    <a href={sectionUrl('projects')} class="text-link">
      ← All projects
    </a>
    <header class="case-header">
      <p class="eyebrow">{project.data.category}</p>
      <h1>{project.data.title}</h1>
      <p>{project.data.description}</p>
      <p class="small-label">{project.data.role}</p>
      <ul class="tag-list">
        {project.data.techStack.map((tech) => (
          <li class="tag">{tech}</li>
        ))}
      </ul>
      <div class="button-row">
        <a
          class="btn-primary"
          href={project.data.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          View source code ↗
        </a>
        {project.data.liveUrl && (
          <a
            class="btn-outline"
            href={project.data.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Visit live site ↗
          </a>
        )}
        {project.id === 'condolink' && (
          <a href="#booking-demo" class="btn-outline">
            Try sample workflow ↓
          </a>
        )}
      </div>
    </header>
    <figure class="case-hero">
      <Image
        src={project.data.image}
        alt={project.data.imageAlt}
        widths={[640, 960, 1280]}
        sizes="(min-width: 1200px) 1152px, 100vw"
        width={1280}
        format="webp"
        loading="eager"
      />
      <figcaption>{project.data.imageCaption}</figcaption>
    </figure>
    <div class="case-layout">
      <aside class="case-aside">
        <nav aria-label="In this case study">
          <p class="eyebrow">In this case study</p>
          <ol>
            {headings
              .filter((heading) => heading.depth === 2)
              .map((heading) => (
                <li>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
          </ol>
        </nav>
      </aside>
      <div>
        <div class="mdx-content">
          <Content />
        </div>
        {project.id === 'condolink' && <WorkflowDemo />}
        {repository && (
          <details class="repo-context">
            <summary>Repository context</summary>
            <p>
              Primary repository language: {repository.language || 'Not listed'}
              . Last code update:{' '}
              <time datetime={repository.pushedAt}>
                {new Date(repository.pushedAt).toLocaleDateString('en-GB', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                  timeZone: 'UTC',
                })}
              </time>
              .
            </p>
            <p>
              Snapshot checked{' '}
              {snapshot.checkedAt
                ? new Date(snapshot.checkedAt).toLocaleDateString('en-GB', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                    timeZone: 'UTC',
                  })
                : 'at build time'}
              .{' '}
              <a
                class="text-link"
                href={project.data.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                See current repository ↗
              </a>
            </p>
          </details>
        )}
      </div>
    </div>
    <nav class="project-pagination" aria-label="More projects">
      {previous ? (
        <a class="text-link" href={assetUrl(`projects/${previous.id}/`)}>
          ← {previous.data.title}
        </a>
      ) : (
        <span></span>
      )}
      {next && (
        <a class="text-link" href={assetUrl(`projects/${next.id}/`)}>
          {next.data.title} →
        </a>
      )}
    </nav>
  </article>
</BaseLayout>
