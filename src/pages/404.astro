---
import BaseLayout from '../layouts/BaseLayout.astro';
import { homeUrl, sectionUrl } from '../data/site';
---

<BaseLayout noindex title="Page not found — Andrei Rosca">
  <section class="container not-found">
    <p class="eyebrow">Page not found</p>
    <h1>A small detour.</h1>
    <p>
      This page may have moved. You can head back to the portfolio or explore
      the projects.
    </p>
    <div class="button-row">
      <a href={homeUrl} class="btn-primary">
        Back to home
      </a>
      <a href={sectionUrl('projects')} class="btn-outline">
        Explore projects
      </a>
    </div>
  </section>
</BaseLayout>
