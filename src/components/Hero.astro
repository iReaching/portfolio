---
import { site, sectionUrl, resumePageUrl } from '../data/site';
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="availability">
      <span aria-hidden="true"></span>
      {site.availability}
    </p>
    <p class="eyebrow">Hello, I'm Andrei Rosca.</p>
    <h1 id="hero-title">
      Practical software.
      <br />
      <span>Thoughtful support.</span>
    </h1>
    <p class="hero-description">
      I build responsive web applications and help people get their technology
      working. A developer’s curiosity, grounded in hands-on IT support.
    </p>
    <div class="button-row">
      <a class="btn-primary" href={sectionUrl('projects')}>
        Explore my work <span aria-hidden="true">↗</span>
      </a>
      <a class="btn-outline" href={resumePageUrl}>
        View résumé <span aria-hidden="true">↗</span>
      </a>
    </div>
    <p class="hero-location">
      <span aria-hidden="true">↗</span> {site.location}
    </p>
  </div>
  <aside class="hero-note" aria-label="At a glance">
    <p class="eyebrow">A little context</p>
    <div class="hero-stat">
      <strong>
        486<span> hrs</span>
      </strong>
      <p>Hands-on university IT support training</p>
    </div>
    <div class="hero-note-rule"></div>
    <p class="small-label">From interface to database</p>
    <p>
      React & TypeScript
      <br />
      PHP & MySQL
    </p>
    <a class="text-link" href={sectionUrl('experience')}>
      Meet the person behind the projects <span aria-hidden="true">↗</span>
    </a>
  </aside>
</section>
