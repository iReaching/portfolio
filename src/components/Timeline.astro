---
import SectionHeading from './SectionHeading.astro';
import { experience, professionalDevelopment } from '../data/profile';
import { assetUrl } from '../data/site';
---

<section id="experience" class="section container">
  <SectionHeading
    eyebrow="Experience"
    title="Building things. Helping people."
    description="Project ownership and hands-on support in a real IT environment."
  />
  <ol class="experience-list">
    {experience.map((item) => (
      <li class="experience-item" data-reveal>
        <div class="experience-date">
          <time datetime={item.start}>{item.date}</time>
          <span>
            {item.project ? 'Capstone project' : 'On-the-job training'}
          </span>
        </div>
        <article>
          <p class="small-label">{item.organization}</p>
          <h3>{item.title}</h3>
          <p>{item.summary}</p>
          <ul>
            {item.bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
          <div class="tag-list">
            {item.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
          {item.project && (
            <a class="text-link" href={assetUrl(`projects/${item.project}/`)}>
              Read the case study <span aria-hidden="true">↗</span>
            </a>
          )}
        </article>
      </li>
    ))}
  </ol>
  <details class="development">
    <summary>
      Professional development <span>Seminar attendance · 2026</span>
    </summary>
    <ul>
      {professionalDevelopment.map((item) => (
        <li>
          <time datetime={item.date}>{item.label}</time> ? {item.title}
        </li>
      ))}
    </ul>
  </details>
</section>
