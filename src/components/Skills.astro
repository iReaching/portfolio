---
import SectionHeading from './SectionHeading.astro';
import { skillGroups } from '../data/profile';
import { assetUrl, sectionUrl } from '../data/site';
---

<section id="skills" class="section section-tinted">
  <div class="container">
    <SectionHeading
      eyebrow="Tools with a purpose"
      title="Skills, connected to the work."
      description="The technologies I use, and where I’ve put them into practice."
    />
    <div class="skills-grid">
      {skillGroups.map((group, i) => (
        <article class="skill-card" data-reveal>
          <span class="index-number" aria-hidden="true">
            0{i + 1}
          </span>
          <h3>{group.title}</h3>
          <ul class="tag-list">
            {group.skills.map((skill) => (
              <li class="tag">{skill}</li>
            ))}
          </ul>
          <p>{group.evidence}</p>
          <a
            class="text-link"
            href={
              group.project
                ? assetUrl(`projects/${group.project}/`)
                : sectionUrl('experience')
            }
          >
            See the experience <span aria-hidden="true">↗</span>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
