---
import { homeUrl, resumePageUrl, sectionUrl } from '../data/site';
const links = [
  { label: 'Work', id: 'projects' },
  { label: 'Experience', id: 'experience' },
  { label: 'Skills', id: 'skills' },
  { label: 'About', id: 'about' },
  { label: 'Contact', id: 'contact' },
];
---

<header class="site-header">
  <nav class="container nav-shell" aria-label="Primary navigation">
    <a class="wordmark" href={homeUrl} aria-label="Andrei Rosca, home">
      <span class="monogram" aria-hidden="true">
        ar<span>.</span>
      </span>
      <span>Andrei Rosca</span>
    </a>
    <div class="nav-actions">
      <label class="theme-control">
        <span class="sr-only">Color theme</span>
        <select id="theme-choice" aria-label="Color theme">
          <option value="system">System</option>
          <option value="light">Light</option>
          <option value="dark">Dark</option>
        </select>
      </label>
      <details class="navigation" id="navigation" open>
        <summary aria-controls="navigation-links">
          Menu <span aria-hidden="true">☰</span>
        </summary>
        <div class="navigation-links" id="navigation-links">
          {links.map((link) => (
            <a href={sectionUrl(link.id)} data-section={link.id}>
              {link.label}
            </a>
          ))}
          <a href={resumePageUrl} class="nav-resume">
            Résumé <span aria-hidden="true">↗</span>
          </a>
        </div>
      </details>
    </div>
  </nav>
</header>
<script>
  const details = document.querySelector<HTMLDetailsElement>('#navigation');
  const summary = details?.querySelector('summary');
  const desktop = matchMedia('(min-width: 64rem)');
  const syncNavigation = () => {
    if (details) {
      details.open = desktop.matches;
      summary?.setAttribute('aria-expanded', String(details.open));
    }
  };
  syncNavigation();
  desktop.addEventListener('change', syncNavigation);
  details?.addEventListener('toggle', () =>
    summary?.setAttribute('aria-expanded', String(details.open)),
  );
  details?.querySelectorAll('a').forEach((link) =>
    link.addEventListener('click', () => {
      if (!desktop.matches) {
        details.open = false;
        const target = document.getElementById(link.dataset.section || '');
        if (target) {
          target.setAttribute('tabindex', '-1');
          target.focus({ preventScroll: true });
        }
      }
    }),
  );
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && details?.open && !desktop.matches) {
      details.open = false;
      summary?.focus();
    }
  });
  document.addEventListener('click', (event) => {
    if (
      details?.open &&
      !desktop.matches &&
      event.target instanceof Node &&
      !details.contains(event.target)
    )
      details.open = false;
  });
  const theme = document.querySelector<HTMLSelectElement>('#theme-choice');
  const system = matchMedia('(prefers-color-scheme: dark)');
  let preference = 'system';
  try {
    preference = localStorage.getItem('portfolio-theme') || 'system';
  } catch {}
  if (theme)
    theme.value = ['system', 'dark', 'light'].includes(preference)
      ? preference
      : 'system';
  const applyTheme = () => {
    document.documentElement.dataset.theme =
      theme?.value === 'system'
        ? system.matches
          ? 'dark'
          : 'light'
        : theme?.value || 'dark';
  };
  theme?.addEventListener('change', () => {
    applyTheme();
    try {
      localStorage.setItem('portfolio-theme', theme.value);
    } catch {}
  });
  system.addEventListener('change', applyTheme);
  const navLinks = [
    ...document.querySelectorAll<HTMLAnchorElement>('[data-section]'),
  ];
  const sections = navLinks
    .map((link) => document.getElementById(link.dataset.section!))
    .filter((el): el is HTMLElement => !!el)
    .sort((a, b) => a.offsetTop - b.offsetTop);
  if (sections.length) {
    const updateActive = () => {
      let active: string | undefined;
      for (const section of sections)
        if (section.getBoundingClientRect().top <= 160) active = section.id;
      for (const link of navLinks) {
        if (link.dataset.section === active)
          link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      }
    };
    let scheduled = false;
    window.addEventListener(
      'scroll',
      () => {
        if (!scheduled) {
          scheduled = true;
          requestAnimationFrame(() => {
            updateActive();
            scheduled = false;
          });
        }
      },
      { passive: true },
    );
    updateActive();
  }
</script>
