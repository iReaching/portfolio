---
import { resumePageUrl, resumeUrl } from '../data/site';
---

<section
  id="resume"
  class="container resume-callout"
  aria-labelledby="resume-title"
>
  <div>
    <p class="eyebrow">The concise version</p>
    <h2 id="resume-title">Take my experience with you.</h2>
    <p>A quick overview of my projects, IT support background, and skills.</p>
  </div>
  <div class="button-row">
    <a class="btn-primary" href={resumePageUrl}>
      Read résumé <span aria-hidden="true">↗</span>
    </a>
    <a class="btn-outline" href={resumeUrl} download="Andrei-Rosca-Resume.pdf">
      Download PDF <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>
