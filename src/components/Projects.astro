---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { assetUrl } from '../data/site';
import SectionHeading from './SectionHeading.astro';
const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
if (!projects.length)
  throw new Error(
    'The project collection is empty. Refusing to build a portfolio without projects.',
  );
const categories = [
  ...new Set(projects.map((project) => project.data.category)),
];
---

<section id="projects" class="section container work-section">
  <div class="work-heading">
    <SectionHeading
      eyebrow="Selected work"
      title="A few things I’ve built."
      description="Web applications, interactive experiments, and the decisions behind them."
    />
    <fieldset class="filter-controls" id="project-filters" hidden>
      <legend>Filter projects</legend>
      {['All projects', ...categories].map((category, i) => (
        <button
          type="button"
          aria-pressed={i === 0 ? 'true' : 'false'}
          data-filter={category}
        >
          {category}
        </button>
      ))}
    </fieldset>
  </div>
  <div class="project-grid" id="project-grid">
    {projects.map((project) => (
      <article
        class:list={[
          'project-card',
          { 'project-featured': project.data.featured },
        ]}
        data-category={project.data.category}
        data-reveal
      >
        <a
          class="project-preview"
          href={assetUrl(`projects/${project.id}/`)}
          aria-label={`Read the ${project.data.title} case study`}
        >
          <Image
            src={project.data.image}
            alt={project.data.imageAlt}
            widths={[480, 800, 1280]}
            sizes="(min-width: 1024px) 650px, (min-width: 672px) 50vw, 100vw"
            width={1280}
            format="webp"
            loading="lazy"
          />
          <span class="project-caption">{project.data.imageCaption}</span>
        </a>
        <div class="project-body">
          <p class="project-type">
            {project.data.featured
              ? 'Featured case study'
              : project.data.category}
          </p>
          <h3>
            <a href={assetUrl(`projects/${project.id}/`)}>
              {project.data.title}
            </a>
          </h3>
          <p>{project.data.description}</p>
          <p class="project-role">{project.data.role}</p>
          <ul class="tag-list">
            {project.data.techStack.map((tech) => (
              <li class="tag">{tech}</li>
            ))}
          </ul>
          <div class="project-links">
            <a href={assetUrl(`projects/${project.id}/`)}>
              Read case study <span aria-hidden="true">↗</span>
            </a>
            <a
              href={project.data.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`View ${project.data.title} source on GitHub`}
            >
              Source code ↗
            </a>
            {project.data.liveUrl && (
              <a
                href={project.data.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Open ${project.data.title} live website`}
              >
                Live site ↗
              </a>
            )}
          </div>
        </div>
      </article>
    ))}
  </div>
  <p
    class="results-count"
    id="project-count"
    role="status"
    aria-live="polite"
    hidden
  >
    {projects.length} projects
  </p>
</section>
<script>
  const filters = document.getElementById('project-filters');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-category]')];
  const count = document.getElementById('project-count');
  if (filters && count) {
    filters.hidden = false;
    count.hidden = false;
    filters.querySelectorAll<HTMLButtonElement>('button').forEach((button) =>
      button.addEventListener('click', () => {
        filters
          .querySelectorAll('button')
          .forEach((other) =>
            other.setAttribute('aria-pressed', String(other === button)),
          );
        let visible = 0;
        for (const card of cards) {
          card.hidden =
            button.dataset.filter !== 'All projects' &&
            card.dataset.category !== button.dataset.filter;
          if (!card.hidden) {
            visible++;
            card.classList.remove('reveal-pending');
          }
        }
        count.textContent = `${visible} ${visible === 1 ? 'project' : 'projects'}`;
      }),
    );
  }
</script>
